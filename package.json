{
  "name": "client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start || node ./node_modules/expo/bin/cli start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo start --android || node ./node_modules/expo/bin/cli start --android",
    "ios": "npx expo start --ios || node ./node_modules/expo/bin/cli start --ios",
    "web": "npx expo start --web || node ./node_modules/expo/bin/cli start --web",
    "lint": "npx expo lint || node ./node_modules/expo/bin/cli lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-summary lcov",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:performance": "jest tests/performance"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.101.1",
    "babel-preset-expo": "^55.0.11",
    "bcryptjs": "^3.0.3",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-device": "^55.0.16",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^55.0.22",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~56.0.5",
    "ionicons": "^8.0.13",
    "mermaid": "^11.14.0",
    "nativewind": "^4.2.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bcrypt": "^2.4.0",
    "react-native-css-interop": "^0.2.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.98.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@supabase/supabase-js)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^react-native-css-interop$": "<rootDir>/tests/__mocks__/cssInteropMock.js",
      "^react-native-css-interop/(.*)$": "<rootDir>/tests/__mocks__/cssInteropMock.js",
      "^nativewind$": "<rootDir>/tests/__mocks__/cssInteropMock.js",
      "^nativewind/jsx-runtime$": "<rootDir>/tests/__mocks__/nativewindJsxRuntimeMock.cjs",
      "^nativewind/(.*)$": "<rootDir>/tests/__mocks__/cssInteropMock.js",
      "^react/jsx-runtime$": "<rootDir>/tests/__mocks__/reactJsxRuntimeMock.cjs",
      "^@expo/vector-icons/build/Ionicons$": "<rootDir>/tests/__mocks__/vectorIconMock.js",
      "^@expo/vector-icons/(.*)$": "<rootDir>/tests/__mocks__/vectorIconMock.js",
      "^@react-native-picker/picker$": "<rootDir>/tests/__mocks__/pickerMock.js"
    },
    "testPathIgnorePatterns": [
      "tests/e2e"
    ],
    "collectCoverageFrom": [
      "app/**/*.{js,jsx,ts,tsx}",
      "components/**/*.{js,jsx,ts,tsx}",
      "context/**/*.{js,jsx,ts,tsx}",
      "lib/**/*.{js,jsx,ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "private": true
}
